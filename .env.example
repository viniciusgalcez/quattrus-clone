# =============================================================================
# Gestiona - variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
#   cp .env.example .env
# NUNCA faça commit do `.env` (ele está no .gitignore).
# =============================================================================

# --- Banco de dados (obrigatório) -------------------------------------------
# String de conexão PostgreSQL usada pelo Prisma.
# Local (docker compose up postgres):
DATABASE_URL="postgresql://quattrus:quattrus@localhost:5432/quattrus?schema=public"
# Dentro do docker compose o host é o nome do serviço:
# DATABASE_URL="postgresql://quattrus:quattrus@postgres:5432/quattrus?schema=public"

# --- Autenticação (obrigatório) ---------------------------------------------
# Segredo usado pelo NextAuth v5 para assinar/criptografar os JWTs.
# Sem ele a aplicação lança `MissingSecret` em produção.
# Gere um valor com:
#   openssl rand -base64 32
AUTH_SECRET=""

# Necessário quando a app roda atrás de um proxy/load balancer (Docker, Nginx).
AUTH_TRUST_HOST="true"

# --- Credenciais do PostgreSQL (docker compose) ------------------------------
# Usados apenas pelo serviço `postgres` do docker-compose.yml.
# Se não forem definidos, o compose usa os defaults locais (quattrus/quattrus).
POSTGRES_USER="quattrus"
POSTGRES_PASSWORD="quattrus"
POSTGRES_DB="quattrus"

# Porta publicada pelo serviço web no host.
WEB_PORT="3000"

# --- Seed destrutivo (apenas desenvolvimento) --------------------------------
# `prisma/seed.ts` APAGA todos os dados antes de recriar as fixtures de demo.
# Por segurança ele se recusa a rodar a menos que esta flag esteja em "true"
# E NODE_ENV seja diferente de "production".
ALLOW_DESTRUCTIVE_SEED="false"
